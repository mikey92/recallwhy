{
  "name": "recallwhy",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "gen": "tsx scripts/gen-synthetic.ts",
    "load": "tsx scripts/load-postgres.ts",
    "agents": "tsx src/cli.ts run",
    "decide": "tsx src/cli.ts decide",
    "queue": "tsx src/cli.ts queue",
    "approve": "tsx src/cli.ts approve",
    "eval": "tsx eval/run.ts",
    "setup:zetaris": "tsx scripts/setup-zetaris.ts",
    "view": "tsx src/serve.ts",
    "api": "tsx src/api.ts",
    "check:claims": "tsx scripts/check-claims.ts",
    "demo": "SAMPLE_MODE=true LLM_PROVIDER=none tsx src/cli.ts run --since 2026-09-15 --limit 5",
    "check:repro": "tsx scripts/check-eval-repro.ts",
    "verify": "tsc --noEmit -p . && npm test --silent && npm run check:claims --silent && npm run check:engines --silent && npm run check:scout --silent && npm run check:repro --silent",
    "check:engines": "tsx scripts/check-engines.ts",
    "check:data": "tsx scripts/check-data.ts",
    "check:scout": "tsx scripts/check-scout.ts",
    "check:scout:heldout": "tsx scripts/check-scout-heldout.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.4.1-r.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
