RW_PG_USER=recallwhy
RW_PG_PASSWORD=change-me
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ORG_ID=
# Primary AI provider: Meterless Nightshift (OpenAI-compatible Runtime API on this machine).
# Nightshift ▸ Console gives the URL and API key; the NVIDIA key lives in Nightshift ▸ Setup ▸ Providers, not here.
LLM_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Alternatives (not the default): LLM_PROVIDER=ollama with LLM_MODEL/OLLAMA_URL, or openai with OPENAI_BASE_URL/OPENAI_API_KEY
LLM_MODEL=nemotron-3-nano
OLLAMA_URL=http://127.0.0.1:11434
OPENAI_BASE_URL=
OPENAI_API_KEY=
SAMPLE_MODE=false
